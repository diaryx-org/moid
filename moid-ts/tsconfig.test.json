// Type-checks the sources and the test suite together. Emits nothing — the
// tests run straight off .ts via Node's type stripping.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["src", "test"]
}
